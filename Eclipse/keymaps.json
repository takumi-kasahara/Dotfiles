[
  {
    "command": "-ahk++.debug",
    "keybinding": "f9",
    "when": "editorLangId == 'ahk'"
  },
  {
    "command": "-close.window",
    "keybinding": "ctrl+w"
  },
  {
    "command": "-cursorColumnSelectDown",
    "keybinding": "ctrl+shift+alt+down",
    "when": "textInputFocus"
  },
  {
    "command": "-cursorColumnSelectUp",
    "keybinding": "ctrl+shift+alt+up",
    "when": "textInputFocus"
  },
  {
    "command": "-deleteLeft",
    "keybinding": "shift+backspace"
  },
  {
    "command": "-editor.action.blockComment",
    "keybinding": "shift+alt+a",
