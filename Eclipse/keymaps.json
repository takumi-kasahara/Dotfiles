    "when": "debugState == 'stopped'"
  },
  {
    "command": "hexEditor.openFile",
    "keybinding": "ctrl+alt+h"
  },
  {
    "command": "markdown.extension.editing.toggleCodeSpan",
    "keybinding": "ctrl+alt+c",
