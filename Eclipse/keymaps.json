  },
  {
    "command": "markdown.showPreviewToSide",
    "keybinding": "ctrl+shift+v",
    "when": "!notebookEditorFocused && editorLangId == 'markdown'"
  },
  {
    "command": "rainbow-csv.Align",
    "keybinding": "shift+alt+a",
    "when": "editorTextFocus && editorLangId == 'csv' || editorTextFocus && editorLangId == 'tsv'"
  },
  {
    "command": "rainbow-csv.Shrink",
    "keybinding": "shift+alt+f",
    "when": "editorTextFocus && editorLangId == 'csv' || editorTextFocus && editorLangId == 'tsv'"
  },
  {
    "command": "search-in-workspace.replace",
    "keybinding": "shift+ctrl+h"
  },
  {
    "command": "task:run:build",
    "keybinding": "shift+ctrl+b"
  },
  {
    "command": "textEditor.commands.go.back",
    "keybinding": "ctrl+-"
  },
  {
    "command": "textEditor.commands.go.forward",
    "keybinding": "shift+ctrl+-"
  },
  {
    "command": "workbench.action.closeActiveEditor",
    "keybinding": "ctrl+w"
  },
  {
    "command": "workbench.action.closeAllEditors",
    "keybinding": "ctrl+shift+f4"
  },
  {
    "command": "workbench.action.compareEditor.nextChange",
    "keybinding": "alt+down",
    "when": "textCompareEditorVisible"
  },
  {
    "command": "workbench.action.compareEditor.previousChange",
    "keybinding": "alt+up",
    "when": "textCompareEditorVisible"
  },
  {
    "command": "workbench.action.tasks.restartTask",
    "keybinding": "ctrl+alt+r",
    "when": "taskCommandsRegistered"
  },
  {
    "command": "workbench.action.tasks.runTask",
    "keybinding": "ctrl+alt+t",
    "when": "taskCommandsRegistered"
  },
  {
    "command": "workbench.action.tasks.terminate",
    "keybinding": "ctrl+alt+q",
    "when": "taskCommandsRegistered"
  },
  {
    "command": "workbench.action.tasks.test",
    "keybinding": "ctrl+alt+e",
    "when": "taskCommandsRegistered"
  },
  {
    "command": "workbench.action.terminal.kill",
    "keybinding": "ctrl+w",
    "when": "terminalFocus"
  },
  {
    "command": "workbench.action.terminal.runActiveFile",
    "keybinding": "f5",
    "when": "editorTextFocus && (editorLangId == 'bat' || editorLangId == 'shellscript')"
  },
  {
    "command": "workbench.files.action.showActiveFileInExplorer",
    "keybinding": "shift+alt+r",
    "when": "editorTextFocus"
  },
  {
    "command": "workbench.view.extension.bookmarks",
    "keybinding": "ctrl+alt+m"
  },
  {
    "command": "workbench.view.extension.todo-tree-container",
    "keybinding": "ctrl+alt+d"
  },
  {
    "command": "workbench.views.editSessions.data.focus",
    "keybinding": "ctrl+alt+s"
  }
