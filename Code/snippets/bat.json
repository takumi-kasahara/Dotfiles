{
  // https://en.wikibooks.org/wiki/Windows_Batch_Scripting
  // #region Template
  "Template.Basic": {
    "prefix": "template-script",
    "body": [
      "@echo off",
      "cd /d \"%~dp0\"",
      "setlocal\n",
      ":begin\n",
      ":process",
      "${0::: statement}\n",
      ":end",
      "pause",
      "exit /b %errorlevel%"
    ]
  },
  "Template.Basic.RunAs": {
    "prefix": "template-script-runas",
    "body": [
      "@echo off",
      "cd /d \"%~dp0\"",
      "setlocal\n",
      ":begin",
      "net session >nul 2>&1",
      "if errorlevel 1 (",
      "\twhere /q sudo >nul 2>&1",
      "\tif errorlevel 1 (",
      "\t\techo ERROR: Access is denied.",
      "\t\tgoto :end",
      "\t) else (",
      "\t\tsudo --inline \"%~0\" %*",
      "\t\texit /b %errorlevel%",
      "\t)",
      ")\n",
      ":process",
      "${0::: statement}\n",
      ":end",
      "pause",
      "exit /b %errorlevel%"
    ]
  },
  // #endregion
  // #region Syntax.For
  "Syntax.For.Sequence": {
    "prefix": "for",
    "body": [
      "for /l %%I in (${1:start},${2:inc::ent},${3:end}) do (",
      "\t${0::: statements}",
      ")"
    ]
  },
  "Syntax.For.Pattern": {
    "prefix": ["find", "for-pattern"],
    "body": [
      "for${1: /d}${2: /r \"${3:path}\"} %%I in (${4:pattern}) do (",
      "\t${0::: statements}",
      ")"
    ]
  },
  "Syntax.For.F": {
    "prefix": "while-read",
    "body": [
      "for /f \"${1:usebackq}${2: skip=${3:0}}${4: eol=${5:;}}${6: delims=${7}}${8: tokens=${9:1}}\" %%I in (${10:pattern}) do (",
      "\t${0::: statements}",
      ")"
    ]
  },
  "Syntax.For.ReadEachCommand": {
    "prefix": "for-each-command",
    "body": [
      "for /f \"usebackq\" %%I in (`${1:command}`) do (",
      "\t${0::: statements}",
      ")"
    ]
  },
  // #endregion
  // #region Syntax.If
  "Syntax.If": {
    "prefix": "If",
    "body": ["if ${1:cond} (", "\t${0::: if_true}", ")"]
  },
  "Syntax.If.Else": {
    "prefix": "If.Else",
    "body": [
      "if ${1:cond} (",
      "\t${0::: if_true}",
      ") else (",
      "\t:: if_false",
      ")"
    ]
  },
  "Syntax.If.Defined": {
    "prefix": "If.Defined",
    "body": ["if not defined ${1:variable} (", "\t${0::: statements}", ")"]
  },
  "Syntax.If.Exist": {
    "prefix": "If.Exist",
    "body": ["if exist \"${1:path}\" (", "\t${0::: statements}", ")"]
  },
  "Syntax.If.NotExist": {
    "prefix": "If.NotExist",
    "body": ["if not exist \"${1:path}\" (", "\t${0::: statements}", ")"]
  },
  // #endregion
  // #region Using
  "Using.SetLocal": {
    "prefix": "Using.SetLocal",
    "body": [
      "setlocal${1: enabledelayedexpansion}",
      "${0::: statements}",
      "endlocal"
    ]
  },
  // #endregion
  // #region Set
  "Set": {
    "prefix": "Set",
    "body": ["set \"${1:variable}=${2:value}\""]
  },
  "Set.From": {
    "prefix": "$()",
    "body": [
      "for /f \"usebackq\" %%I in (`${1:command}`) do set \"${2:variable}=%%I\""
    ]
  },
  "Set.TimeStamp": {
    "prefix": "Set.TimeStamp",
    "body": [
      "for /f \"usebackq\" %%I in (`powershell -NoLogo -NoProfile -Command \"Get-Date -Format 'yyyyMMdd''T''HHmmss'\"`) do set \"TIMESTAMP=%%I\""
    ]
  },
  // #endregion
  // #region Variable
  "Variable.SubString": {
    "prefix": "%SubString",
    "body": ["%${1:variable}:~${2:start}${3:,${4:length}}%"]
  },
  "Variable.Replace": {
    "prefix": "%Replace",
    "body": ["%${1:variable}:${2:find}=${3:replace}%"]
  },
  "Variable.Expand": {
    "prefix": "%Expand",
    "body": [
      // "${3|~,~dp,~nx,~f,~d,~p,~n,~x,~s,~a,~t,~z|}"
      "${1|%,%%|}${3|~,~dp,~nx,~f,~d,~p,~n,~x,~s,~a,~t,~z|}${4:\\$${5:env}:}${2:variable}"
    ]
  },
  // #endregion
  // #region Idiom
  "Idiom.Confirm": {
    "prefix": ["Case", "Confirm"],
    "body": [
      "choice ${1:/c ${2:choices}}${3: /n}${4: /m \"${5:message}\"}${6: /t ${7:timeout} /d ${8:default}}",
      "goto :case_%errorlevel%",
      ":case_0",
      ":: case_0",
      "goto :end_case",
      ":case_1",
      ":: case_1",
      "goto :end_case",
      ":case_2",
      ":: case_2",
      "goto :end_case",
      ":end_case"
    ]
  },
  "Idiom.JoinArgs": {
    "prefix": "Join",
    "body": [
      ":loop",
      "\tif \"%~1\"==\"\" (",
      "\t\tgoto :process",
      "\t)",
      "\tset args=%args% \"%~1\"",
      "\tshift /1",
      "goto :loop"
    ]
  },
  "Idiom.Print": {
    "prefix": "Print",
    "body": ["set /p =\"${1:value}\"<nul"]
  },
  "Idiom.Function": {
    "prefix": ["Fn", "Func"],
    "body": [
      ":: ${1:discription}",
      ":${2:label}",
      "\t$0",
      "exit /b",
      ":: end {2:label}"
    ]
  },
  // #endregion
  // #region MaybeError
  "MaybeError.Try": {
    "prefix": "Try",
    "body": [
      "where /q ${1:command}",
      "if errorlevel 1 (",
      "\t$0",
      "\tgoto :end",
      ")"
    ]
  },
  "MaybeError.Args": {
    "prefix": "Args",
    "body": [
      "if \"%~1\"==\"\" (",
      "\techo USAGE: %~nx0 ${0:args}",
      "\tgoto :end",
      ")"
    ]
  }
  // #endregion
}
