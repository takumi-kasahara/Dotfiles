{
  // #region PLSQL.Template
  "PLSQL.Template.AnonymousBlock": {
    "prefix": "@plsql",
    "body": [
      "declare\n",
      "begin",
      "\t$0",
      "exception",
      "\twhen others then",
      "\t\tnull;",
      "end;",
    ],
  },
  // #endregion
  // #region PLSQL.Structure
  "PLSQL.Structure.If": {
    "prefix": "pl.if",
    "body": [
      "if ${1:condition} then",
      "\t${2:null};",
      "end if;",
    ],
  },
  "PLSQL.Structure.If-Else": {
    "prefix": "pl.if-else",
    "body": [
      "if ${1:condition} then",
      "\t${2:null};",
      "else",
      "\t${0:null};",
      "end if;",
    ],
  },
  "PLSQL.Structure.If-Elsif-Else": {
    "prefix": "pl.if-elsif-else",
    "body": [
      "if ${1:condition} then",
      "\t${2:null};",
      "elsif ${3:else_condition} then",
      "\t${4:null};",
      "else",
      "\t${0:null};",
      "end if;",
    ],
  },
  "PLSQL.Structure.Case.Simple": {
    "prefix": "pl.case.simple",
    "body": [
      "case",
      "\twhen ${1:value} then",
      "\t\t${0:-- statements}",
      "\telse",
      "\t\t-- default_statements",
      "end case;",
    ],
  },
  "PLSQL.Structure.Case.Searched": {
    "prefix": "pl.case.simple",
    "body": [
      "case ${1:expression}",
      "\twhen ${2:condition} then",
      "\t\t${0:-- statements}",
      "\telse",
      "\t\t-- default_statements",
      "end case;",
    ],
  },
  "PLSQL.Structure.For": {
    "prefix": "pl.for",
    "body": [
      "for ${1:index} in ${2:start} .. ${3:end} loop",
      "\t${0:-- statements}",
      "end loop;",
    ],
  },
  "PLSQL.Structure.Loop": {
    "prefix": "pl.loop",
    "body": [
      "${1:while ${2:condition}} loop",
      "\t${0:-- statements}",
      "end loop;",
    ],
  },
  // #endregion
  // #region PLSQL.Select
  "PLSQL.Select": {
    "prefix": "pl.select",
    "body": [
      "select",
      "\t${2:fields}",
      "into",
      "\t${var}",
      "from",
      "\t${3:table}",
      "$0",
      ";",
    ],
  },
  "PLSQL.Select.BulkCollect": {
    "prefix": "pl.select.bulk_collect",
    "body": [
      "select",
      "\t${2:fields}",
      "bulk collect into",
      "\t${1:table_var}",
      "from",
      "\t${3:table}",
      "$0",
      ";",
    ],
  },
  // #endregion
  // #region PLSQL.Declare
  "PLSQL.Declare.Variable": {
    "prefix": "pl.variable.declare",
    "body": [
      "${1:var} ${2:type}${3: not null}${4: default ${5:default_value}};",
    ],
  },
  "PLSQL.Declare.Variable.Constant": {
    "prefix": "pl.const.declare",
    "body": [
      "${1:var} ${2:type} := ${3:value};",
    ],
  },
  "PLSQL.Declare.Type.Collection.AssociativeArray": {
    "prefix": "pl.associative_array.declare",
    "body": [
      "type ${1:t_name} is table of ${2:t_element} index by ${3:t_index}${4: not null};",
    ]
  },
  "PLSQL.Declare.Type.Collection.NestedTable": {
    "prefix": "pl.nested_table.declare",
    "body": [
      "type ${1:t_name} is table of ${2:t_element} ${3: not null};",
    ],
  },
  "PLSQL.Declare.Type.Collection.Varray": {
    "prefix": "pl.varray.declare",
    "body": [
      "type ${1:t_name} is varray(${2:max_index}) of ${3:t_element}",
    ],
  },
  "PLSQL.Declare.Type.Record": {
    "prefix": "pl.record_type.declare",
    "body": [
      "type ${1:t_record} is record (",
      "\t-- <field> <type>$0",
      ");",
    ],
  },
  "PLSQL.Declare.Type.Table": {
    "prefix": "pl.table_type.declare",
    "body": [
      "type ${1:t_name} is table of %{2:table or cursor}%rowtype",
    ],
  },
  // #endregion
  // #region PLSQL.Cursor
  "PLSQL.Cursor.Declare": {
    "prefix": "pl.cursor.declare",
    "body": [
      "cursor ${1:cursor_name[params]} is",
      "\t${0:-- select statement}",
      ";",
    ],
  },
  "PLSQL.Cursor.Fetch": {
    "prefix": "pl.cursor.fetch",
    "body": [
      "open ${1:cursor};",
      "fetch ${1:cursor} into ${2:record};$0",
      "close ${1:cursor};",
    ],
  },
  "PLSQL.Cursor.Property": {
    "prefix": "pl.cursor.property",
    "body": [
      "${1:cursor}%${2|found,notfound,isopen,rowcount|}",
    ],
  },
  "PLSQL.Cursor.For": {
    "prefix": "pl.for.cursor",
    "body": [
      "for ${1:var} in ${2:cursor} loop",
      "\t${3:-- statements}",
      "end loop;",
    ],
  },
  "PLSQL.Cursor.Loop": {
    "prefix": "pl.loop.cursor",
    "body": [
      "open ${1:cursor};",
      "loop",
      "\tfetch ${1:cursor} into ${2:var};",
      "\texit when ${1:cursor}%notfound or ${1:cursor}%notfound is null;",
      "\t${3:-- statements}",
      "end loop;",
      "close ${1:cursor};",
    ],
  },
  "PLSQL.Cursor.BulkFetch": {
    "prefix": "pl.cursor.bulk_fetch",
    "body": [
      "open ${1:cursor};",
      "fetch ${1:cursor} bulk collect into ${2:t_record}${3: limit ${4:max_size}};$0",
      "close ${1:cursor};",
    ],
  },
  "PLSQL.Cursor.ForAll": {
    "prefix": "pl.forall",
    "body": [
      "forall ${1:record} in ${2:cursor}${3: save exceptions}",
      "\t${4:-- statements}",
    ],
  },
  "PLSQL.Cursor.Forall.ValuesOf": {
    "prefix": "pl.forall.association_array",
    "body": [
      "forall ${1|${k} in indice of,v in values of|} ${2:association_array}${3: save exceptions}",
      "\t${4:-- statements}",
    ],
  },
  // #endregion
  // #region PLSQL.Stored
  "PLSQL.Stored.Procedure": {
    "prefix": "pl.proc",
    "body": [
      "${1:create or replace }procedure ${2:name} (",
      "\t-- name [ in | out | in out ] [nocopy] type [:= default_value];",
      ")\nis",
      "\t${0:-- declare block}",
      "begin",
      "\tnull;",
      "end ${2:name};",
    ],
  },
  "PLSQL.Stored.Function": {
    "prefix": "prefix",
    "body": [
      "${1:create or replace }procedure ${2:name} (",
      "\t-- name [ in | out | in out ] [nocopy] type [:= default_value];",
      ")\nreturn ${3:return_type} is",
      "\t${0:-- declare block}",
      "begin",
      "\tnull;",
      "end ${2:name};",
    ],
  },
  // #endregion
}
