  // #region AutoHotkey
  "AHK++.experimental": {
    "funcDefSearch": true,
  },
  "AHK++.v1.formatter": {
    "allowedNumberOfEmptyLines": 1,
    "indentCodeAfterIfDirective": true,
    "indentCodeAfterLabel": true,
    "preserveIndent": true,
    "trimExtraSpaces": true,
  },
  "AHK++.v2.formatter": {
    "arrayStyle": "collapse",
    "braceStyle": "Allman",
    "breakChainedMethods": false,
    "ignoreComment": false,
    "indentBetweenHotIfDirectives": false,
    "indentString": "  ",
    "keywordStartWithUppercase": false,
    "maxPreserveNewlines": 2,
    "objectStyle": "collapse",
    "preserveNewlines": true,
    "spaceAfterDoubleColon": true,
    "spaceBeforeConditional": true,
    "spaceInEmptyParen": false,
    "spaceInOther": true,
    "spaceInParen": false,
    "switchCaseAlignment": false,
    "symbolWithSameCase": false,
    "wrapLineLength": 0,
  },
  "AHK++.v2.general": {
    "actionWhenV1Detected": "Warn",
    "completeFunctionCalls": true,
    "librarySuggestions": "All",
    "symbolFoldingFromOpenBrace": true,
  },
  "AHK++.v2.warn": {
    "callWithoutParentheses": "On",
    "localSameAsGlobal": true,
    "varUnset": true,
  },
