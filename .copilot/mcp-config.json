{
  "mcpServers": {
    "MDN": {
      "tools": ["*"],
      "type": "http",
      "url": "https://mcp.mdn.mozilla.net"
    },
    "Microsoft Release Communications": {
      "tools": ["*"],
      "type": "http",
      "url": "https://www.microsoft.com/releasecommunications/mcp"
    },
    "github": {
      "tools": ["*"],
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "microsoft-learn": {
      "tools": ["*"],
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "nuget": {
      "tools": ["*"],
      "type": "local",
      "command": "dnx",
      "args": [
        "NuGet.Mcp.Server",
        "--source",
        "https://api.nuget.org/v3/index.json",
        "--yes"
      ]
    },
    "playwright": {
      "tools": ["*"],
      "type": "local",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "github-ghas-tools": {
      "tools": ["*"],
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "code_security,secret_protection,security_advisories,dependabot",
        "X-MCP-Tools": "run_secret_scanning"
      }
    }
  }
}
