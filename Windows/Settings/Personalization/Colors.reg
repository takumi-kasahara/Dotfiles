Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize]
"EnableTransparency"=dword:00000000 ; "Personalization > Colors > Transparency effects": False
"ColorPrevalence"=dword:00000000    ; "Personalization > Colors > Show accent color on Start and taskbar": False

[HKEY_CURRENT_USER\Software\Microsoft\Windows\DWM]
"ColorPrevalence"=dword:00000000 ; "Personalization > Colors > Show accent color on title bars and window borders": False

; Dark Theme
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize]
"AppsUseLightTheme"=dword:00000000
"SystemUsesLightTheme"=dword:00000000
