Windows Registry Editor Version 5.00

; Personalization > Taskbar

[HKEY_CURRENT_USER\Control Panel\Accessibility]
MessageDuration=dword:00000005 ; "Accessibility > Visual effects > Dismiss notifications after this amount of time": 5 seconds

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"MMTaskbarGlomLevel"=dword:00000001           ; "Taskbar behaviors > Combine taskbar buttons and hide labels on other taskbars": "When taskbar is full"
"ShowNotificationIcons"=dword:00000001        ; "System > Notification> Show notification bell icon": True
"ShowSecondsInSystemClock"=dword:00000001     ; "Time & language > Date & time > Show seconds in system tray clock": True
"ShowSystrayDateTimeValueName"=dword:00000001 ; "Time & language > Date & time > Show time and date in the System tray": True
"ShowTaskViewButton"=dword:00000000           ; "Personalization > Taskbar > Taskbar items > Task view": Hide
"TaskbarDa"=dword:00000000                    ; "Personalization > Taskbar > Taskbar items > Widgets": Hide
"TaskbarGlomLevel"=dword:00000001             ; "Taskbar behaviors > Combine taskbar button and hide labels": "When taskbar is full"

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Search]
"SearchboxTaskbarMode"=dword:00000000 ; "Personalization > Taskbar > Taskbar items > Search": Hide

[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\Explorer]
"TaskbarNoMultimon"=dword:00000001 ; "Show my taskbar on all displays": False
