Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Thingamahoochie\WinMerge\Backup]
"EnableFile"=dword:00000000
"EnableFolder"=dword:00000000
"GlobalFolder"=""
"Location"=dword:00000000
"NameAddBak"=dword:00000000
"NameAddTime"=dword:00000000

[HKEY_CURRENT_USER\Software\Thingamahoochie\WinMerge\Font]
