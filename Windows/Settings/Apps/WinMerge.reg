"PluginsCustomSettingsList"="EDITOR_SCRIPT.PrettifyXML=filters:\\.xml$;\\.vssettings$;\\.wsf$|automatic:false	FILE_PACK_UNPACK.PrettifyXML=filters:\\.xml$;\\.vssettings$;\\.wsf$|automatic:false"
