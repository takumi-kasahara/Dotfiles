<job id="RuntimeSample">
  <runtime>
    <named name="Input" helpstring="Input path" type="string" required="true" />
    <unnamed name="Output" helpstring="Output path" many="false" required="false" />
  </runtime>
  <script language="JScript">
    WScript.Arguments.ShowUsage();
  </script>
</job>
