<job>
  <runtime>
    <description>This script reboots a server</description>
    <named
      name="Server"
      helpstring="Server to run the script on"
      type="string"
      required="true"
    />
    <example>Example: reboot.wsf /Server:scripting</example>
  </runtime>
  <script language="JScript">
    <![CDATA[
    WScript.Arguments.ShowUsage();
    ]]>
  </script>
</job>
