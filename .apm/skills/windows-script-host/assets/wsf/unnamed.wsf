<job>
  <runtime>
    <unnamed
      name="filename"
      helpstring="The file to process"
      many="false"
      required="true"
    />
  </runtime>
  <script language="JScript">
    <![CDATA[
    WScript.Arguments.ShowUsage();
    ]]>
  </script>
</job>
